    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a data-cleaning assistant for student enrollment records.\nReturn ONLY a JSON object (no explanation, no code fences) with exactly these keys:\n- \"Name\": the student name in Title Case (initials stay capital, e.g. \"Manoj K\")\n- \"Course\": exactly one of \"Python\", \"Machine Learning\", \"Data Science\" (\"ML\" means Machine Learning)\n\nRow:\nName: {{ $json.Name }}\nCourse: {{ $json.Course }}"
      },
      "id": "275731bf-1563-46c3-8e7a-5f0fa0ff7201",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        432,
        304
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0
        }
      },
      "id": "d434d838-e81e-4de2-ab7b-279fb3adf141",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        432,
        528
      ],
      "credentials": {
        "openAiApi": {
          "id": "d1QFwBd9sZVtKnEB",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "18e650c8-7c3a-4168-93ae-0accb215ba41",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        704,
        304
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Runs once for EACH student inside the loop\n// 1) Original row from \"Extract from File\" (paired item), 2) AI answer from Basic LLM Chain\nlet src = {};\ntry { src = $('Extract from File').item.json; } catch (e) { src = {}; }\n\nlet ai = {};\ntry {\n  const t = String($json.text ?? $json.output ?? '').replace(/```json|```/g, '').trim();\n  ai = JSON.parse(t);\n} catch (e) { ai = {}; }\n\nconst clean = v => String(v ?? '').replace(/\\s+/g, ' ').trim();\nconst titleCase = s => clean(s).toLowerCase().split(' ').filter(Boolean)\n  .map(w => w.length <= 2 ? w.toUpperCase() : w[0].toUpperCase() + w.slice(1)).join(' ');\n\n// Course: trust the AI only if it returned an allowed value, else fall back to a map\nconst allowed = ['Python', 'Machine Learning', 'Data Science'];\nconst courseMap = { 'python': 'Python', 'ml': 'Machine Learning', 'machine learning': 'Machine Learning', 'data science': 'Data Science' };\nconst rawCourse = clean(src.Course).toLowerCase();\nconst course = allowed.includes(ai.Course) ? ai.Course : (courseMap[rawCourse] || titleCase(src.Course));\n\nconst email = clean(src.Email).toLowerCase();\nconst emailValid = /^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$/.test(email);\n\nconst phone = String(src.Phone ?? '').replace(/\\D/g, '');\nconst fee = clean(src.Fee_Paid).toLowerCase() === 'yes' ? 'Yes' : 'No';\nconst city = clean(src.City) ? titleCase(src.City) : 'Not Provided';\n\nconst d = clean(src.Enrolled_Date).split('-');            // dd-mm-yyyy\nconst date = d.length === 3 ? `${d[2]}-${d[1]}-${d[0]}` : clean(src.Enrolled_Date); // -> yyyy-mm-dd\n\nreturn {\n  json: {\n    Student_ID: clean(src.Student_ID).toUpperCase(),\n    Name: titleCase(src.Name),\n    Email: email,\n    Email_Status: emailValid ? 'Valid' : 'Invalid',\n    Phone: phone.length === 10 ? phone : '',\n    Course: course,\n    Fee_Paid: fee,\n    City: city,\n    Enrolled_Date: date\n  }\n};"
      },
